<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer classic ink border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FCF9F0" />
            <stroke
                android:width="2dp"
                android:color="#2C2A26" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Inner subtle bronze Mushaf hairline -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FCF9F0" />
            <stroke
                android:width="1dp"
                android:color="#9C8458" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
