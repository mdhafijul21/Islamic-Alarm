<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base gradient: dawn indigo at top fading to soft orange horizon -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/header_fajr_top"
                android:endColor="@color/header_fajr_bottom"
                android:type="linear" />
        </shape>
    </item>

    <!-- Sun, low and small, just appearing -->
    <item
        android:width="70dp"
        android:height="70dp"
        android:gravity="top|end"
        android:drawable="@drawable/ic_sun_decor"
        android:top="40dp"
        android:end="24dp" />

    <!-- Mosque skyline silhouette along the bottom edge -->
    <item
        android:height="90dp"
        android:gravity="bottom|fill_horizontal"
        android:drawable="@drawable/ic_mosque_silhouette" />

</layer-list>
