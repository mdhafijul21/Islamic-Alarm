<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base gradient: dawn indigo at top fading to soft orange horizon -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/header_fajr_top"
                android:endColor="@color/header_fajr_bottom"
                android:type="linear" />
        </shape>
    </item>

    <!-- A few stars still visible in the upper, darker part of the sky -->
    <item
        android:height="90dp"
        android:gravity="top|fill_horizontal"
        android:drawable="@drawable/ic_stars_decor" />

    <!-- Soft clouds for depth -->
    <item
        android:width="260dp"
        android:height="60dp"
        android:gravity="top|start"
        android:drawable="@drawable/ic_clouds_decor"
        android:top="34dp"
        android:start="8dp" />

    <!-- Sun, low and small, just appearing -->
    <item
        android:width="68dp"
        android:height="68dp"
        android:gravity="top|end"
        android:drawable="@drawable/ic_sun_decor"
        android:top="44dp"
        android:end="24dp" />

    <!-- Detailed mosque skyline silhouette along the bottom edge -->
    <item
        android:height="100dp"
        android:gravity="bottom|fill_horizontal"
        android:drawable="@drawable/ic_mosque_silhouette_v2" />

</layer-list>
