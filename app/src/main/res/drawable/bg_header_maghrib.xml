<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base gradient: dusky purple at top fading to warm sunset orange -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/header_maghrib_top"
                android:endColor="@color/header_maghrib_bottom"
                android:type="linear" />
        </shape>
    </item>

    <!-- Soft clouds catching the sunset light -->
    <item
        android:width="260dp"
        android:height="60dp"
        android:gravity="top|end"
        android:drawable="@drawable/ic_clouds_decor"
        android:top="26dp"
        android:end="-10dp" />

    <!-- Sun, low near the horizon, large and warm -->
    <item
        android:width="80dp"
        android:height="80dp"
        android:gravity="bottom|end"
        android:drawable="@drawable/ic_sun_decor"
        android:bottom="66dp"
        android:end="30dp" />

    <!-- Detailed mosque skyline silhouette along the bottom edge -->
    <item
        android:height="100dp"
        android:gravity="bottom|fill_horizontal"
        android:drawable="@drawable/ic_mosque_silhouette_v2" />

</layer-list>
