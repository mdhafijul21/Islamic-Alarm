<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solid continuation below the photo band, matching its own bottom edge color
         so the header stays seamless even where it's taller than the photo itself -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/header_teal_bottom" />
        </shape>
    </item>

    <!-- Real photo: moon, clouds, stars and mosque skyline, cropped from the user's
         own reference image -->
    <item
        android:height="170dp"
        android:gravity="top|fill_horizontal"
        android:drawable="@drawable/bg_header_photo_night" />

</layer-list>
