<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base gradient: bright sky blue fading to deeper blue -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/header_day_top"
                android:endColor="@color/header_day_bottom"
                android:type="linear" />
        </shape>
    </item>

    <!-- Sun, high and bright -->
    <item
        android:width="92dp"
        android:height="92dp"
        android:gravity="top|end"
        android:drawable="@drawable/ic_sun_decor"
        android:top="18dp"
        android:end="18dp" />

    <!-- Mosque skyline silhouette along the bottom edge -->
    <item
        android:height="90dp"
        android:gravity="bottom|fill_horizontal"
        android:drawable="@drawable/ic_mosque_silhouette" />

</layer-list>
