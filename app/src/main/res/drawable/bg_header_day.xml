<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base gradient: bright sky blue fading to deeper blue -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/header_day_top"
                android:endColor="@color/header_day_bottom"
                android:type="linear" />
        </shape>
    </item>

    <!-- Soft clouds for depth -->
    <item
        android:width="260dp"
        android:height="60dp"
        android:gravity="top|start"
        android:drawable="@drawable/ic_clouds_decor"
        android:top="30dp"
        android:start="-20dp" />
    <item
        android:width="200dp"
        android:height="50dp"
        android:gravity="top|end"
        android:drawable="@drawable/ic_clouds_decor"
        android:top="70dp"
        android:end="-30dp" />

    <!-- Sun, high and bright -->
    <item
        android:width="92dp"
        android:height="92dp"
        android:gravity="top|end"
        android:drawable="@drawable/ic_sun_decor"
        android:top="18dp"
        android:end="18dp" />

    <!-- Detailed mosque skyline silhouette along the bottom edge -->
    <item
        android:height="100dp"
        android:gravity="bottom|fill_horizontal"
        android:drawable="@drawable/ic_mosque_silhouette_v2" />

</layer-list>
