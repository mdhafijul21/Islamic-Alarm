<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#16191F"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Icon"
            android:src="@drawable/ic_islamic_star_badge" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="ইসলামিক এলার্ম"
            android:textColor="#D4AF37"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnWidgetRefresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Refresh"
            android:src="@android:drawable/ic_popup_sync" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvWidgetNextPrayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="পরবর্তী এলার্ম: নির্ধারিত নেই"
        android:textColor="#F8FAFC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetSehriIftar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="সাহরী ০৪:২০ AM | ইফতার ০৬:৩০ PM"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

</LinearLayout>
