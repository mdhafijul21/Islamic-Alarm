<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Number badge -->
            <TextView
                android:id="@+id/tvNameNumber"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_challenge_badge"
                android:gravity="center"
                android:textColor="@color/secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="১" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNameTransliteration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="আর-রাহমান" />

                <TextView
                    android:id="@+id/tvNameMeaning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary"
                    android:textSize="13sp"
                    tools:text="পরম দয়ালু" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvNameArabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="الرَّحْمَنُ" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/border" />

        <!-- Virtue / Benefit -->
        <TextView
            android:id="@+id/tvNameVirtue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="যে ব্যক্তি প্রতিদিন ১০০ বার পাঠ করবে, তার অন্তর থেকে অবহেলা ও অলসতা দূর হবে।" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
