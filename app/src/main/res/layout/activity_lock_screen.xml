<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_islamic_mosque"
    android:keepScreenOn="true"
    tools:context="com.hafij.islamicalarm.LockScreenActivity">

    <!-- Dark Overlay for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6020E10" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Islamic Emblem / Moon Icon -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_foreground"
            app:tint="@color/gold_accent" />

        <!-- Main Heading: "এখন নামাজের সময়" -->
        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/now_prayer_time"
            android:textColor="@color/gold_accent"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Alarm Label (e.g., "ফজর" or "জিকির") -->
        <TextView
            android:id="@+id/tvLockAlarmLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_duration_chip"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:textColor="@color/primary_variant"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="ফজর"
            tools:visibility="visible" />

        <!-- Arabic Ayah -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="@string/arabic_ayah"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Ayah Translation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/ayah_translation"
            android:textColor="#D0E8EA"
            android:textSize="14sp" />

        <!-- Divider Line -->
        <View
            android:layout_width="160dp"
            android:layout_height="1dp"
            android:layout_marginVertical="32dp"
            android:background="#40FFD700" />

        <!-- Remaining Time Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remaining_time"
            android:textColor="#B0D8DC"
            android:textSize="15sp"
            android:letterSpacing="0.05" />

        <!-- Countdown Timer (mm:ss) -->
        <TextView
            android:id="@+id/tvCountdownTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/white"
            android:textSize="56sp"
            android:textStyle="bold"
            tools:text="15:00" />

        <!-- Screen Lock Status Message -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/locked_title"
            android:textColor="#A0C8CC"
            android:textSize="13sp" />

    </LinearLayout>

</RelativeLayout>
