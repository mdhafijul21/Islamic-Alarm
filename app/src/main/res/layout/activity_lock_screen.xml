<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_islamic_mosque"
    android:keepScreenOn="true"
    tools:context="com.hafij.islamicalarm.LockScreenActivity">

    <!-- Main Content Container matching user screenshot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="180dp"
        android:paddingBottom="40dp">

        <!-- Main Heading: "এখন নামাজের সময়" -->
        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/now_prayer_time"
            android:textColor="@color/gold_accent"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Optional Alarm Label (if set) -->
        <TextView
            android:id="@+id/tvLockAlarmLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/gold_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="ফজর সালাত"
            tools:visibility="visible" />

        <!-- Arabic Ayah -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:text="@string/arabic_ayah"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Ayah Translation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/ayah_translation"
            android:textColor="#D0E8EA"
            android:textSize="14sp" />

        <!-- Divider Line -->
        <View
            android:layout_width="160dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="28dp"
            android:background="#40FFD700" />

        <!-- Remaining Time Title: "অবশিষ্ট সময়" -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="@string/remaining_time"
            android:textColor="#B0D8DC"
            android:textSize="16sp" />

        <!-- Countdown Timer (mm:ss) e.g. "00:44" -->
        <TextView
            android:id="@+id/tvCountdownTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/white"
            android:textSize="64sp"
            android:textStyle="bold"
            tools:text="00:44" />

        <!-- Subtext: "নামাজের জন্য মোবাইল ব্যবহারের সময় নিয়ন্ত্রিত" -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/locked_title"
            android:textColor="#A0C8CC"
            android:textSize="14sp" />

    </LinearLayout>

</RelativeLayout>
