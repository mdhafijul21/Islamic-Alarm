<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_islamic_mosque"
    android:keepScreenOn="true"
    tools:context="com.hafij.islamicalarm.LockScreenActivity">

    <!-- Dark Overlay for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8020E10" />

    <!-- Top Lockdown Notice Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_duration_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="🔒 সালাত মোড সক্রিয় • ব্যাক বাটন ও হোম বাটন লক"
            android:textColor="@color/primary_variant"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="36dp">

        <!-- Islamic Emblem / Star Badge -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_islamic_star_badge" />

        <!-- Main Heading: "এখন নামাজের সময়" -->
        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/now_prayer_time"
            android:textColor="@color/gold_accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Alarm Label (e.g., "ফজর" or "জিকির") -->
        <TextView
            android:id="@+id/tvLockAlarmLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_challenge_badge"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:textColor="@color/gold_accent"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="ফজর সালাত"
            tools:visibility="visible" />

        <!-- Arabic Ayah -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="@string/arabic_ayah"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Ayah Translation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/ayah_translation"
            android:textColor="#D0E8EA"
            android:textSize="13sp" />

        <!-- Divider Line -->
        <View
            android:layout_width="140dp"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#40FFD700" />

        <!-- Remaining Time Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="@string/remaining_time"
            android:textColor="#B0D8DC"
            android:textSize="14sp" />

        <!-- Countdown Timer (mm:ss) -->
        <TextView
            android:id="@+id/tvCountdownTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/white"
            android:textSize="50sp"
            android:textStyle="bold"
            tools:text="15:00" />

        <!-- Screen Lock Status Message -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/locked_title"
            android:textColor="#A0C8CC"
            android:textSize="12sp" />

        <!-- Emergency Unlock / Prayer Complete Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlockScreen"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="নামাজ সম্পন্ন হলে চাপ দিয়ে ধরে রাখুন (৩ সেকেন্ড)"
            android:textColor="@color/gold_accent"
            android:textSize="12sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/gold_accent"
            app:strokeWidth="1dp" />

    </LinearLayout>

</RelativeLayout>
