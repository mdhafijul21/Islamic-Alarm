<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context="com.hafij.islamicalarm.quran.SurahDetailActivity">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarSurah"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/secondary"
            app:subtitleTextColor="@color/text_secondary"
            app:title="সুরা আল-ফাতিহা"
            app:titleTextColor="@color/text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Reading & Audio Control Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">

        <!-- Audio Recitation Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlaySurahAudio"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/surface_container"
            android:text="অডিও শুনুন"
            android:textColor="@color/secondary"
            android:textSize="12sp"
            app:icon="@drawable/ic_volume_up"
            app:iconTint="@color/secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Font Zoom Controls -->
        <ImageButton
            android:id="@+id/btnSurahFontSmaller"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Font Smaller"
            android:src="@drawable/ic_zoom_out"
            app:tint="@color/secondary" />

        <TextView
            android:id="@+id/tvSurahFontSizeIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:text="A"
            android:textColor="@color/secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSurahFontLarger"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Font Larger"
            android:src="@drawable/ic_zoom_in"
            app:tint="@color/secondary" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/pbLoadingSurah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/secondary"
            android:visibility="gone" />

        <!-- Error Layout -->
        <LinearLayout
            android:id="@+id/layoutSurahError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="আয়াত লোড করতে সমস্যা হয়েছে"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryLoadSurah"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="পুনরায় চেষ্টা করুন"
                android:textColor="@color/secondary" />

        </LinearLayout>

        <!-- Ayahs RecyclerView with Bismillah Header -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAyahs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_ayah" />

    </FrameLayout>

</LinearLayout>
