<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context="com.hafij.islamicalarm.quran.QuranActivity">

    <!-- Top AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarQuran"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/text_primary"
            app:subtitle="১৫-লাইন এমদাদিয়া হাফেজি কোরআন"
            app:subtitleTextColor="@color/secondary"
            app:title="আল-কুরআন"
            app:titleTextColor="@color/text_primary" />

        <!-- Tab Bar: Surah / Para / 15-Line Reader -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            app:tabIndicatorColor="@color/secondary"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/secondary"
            app:tabTextColor="@color/text_secondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="সুরা সমূহ" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="পারা সমূহ" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="১৫-লাইন পাঠ" />

        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- TAB 1: SURAH LIST VIEW -->
        <LinearLayout
            android:id="@+id/layoutSurahTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Search Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearch"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="সুরা বা নম্বর দিয়ে খুঁজুন..."
                app:boxStrokeColor="@color/secondary"
                app:endIconMode="clear_text"
                app:hintTextColor="@color/secondary"
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:startIconTint="@color/secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearchSurah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Surah List RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSurahList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                tools:listitem="@layout/item_surah" />

        </LinearLayout>

        <!-- TAB 2: PARA LIST VIEW -->
        <LinearLayout
            android:id="@+id/layoutParaTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <!-- Para Search / Info Banner -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="পবিত্র কোরআনের ৩০ টি পারা থেকে বেছে নিন:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvParaList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                tools:listitem="@layout/item_para" />

        </LinearLayout>

        <!-- TAB 3: 15-LINE PAGE READER (Matching Images 1, 2, 3) -->
        <ScrollView
            android:id="@+id/layoutPageTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Jump Header Controls (Matching Image 1) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#191C24"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Para Number:"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etParaNumberInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:backgroundTint="#FFFFFF"
                                android:gravity="center"
                                android:hint="1 - 30"
                                android:inputType="number"
                                android:maxLength="2"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#888888"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Page Number:"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etPageNumberInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:backgroundTint="#FFFFFF"
                                android:gravity="center"
                                android:hint="1 - 604"
                                android:inputType="number"
                                android:maxLength="3"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#888888"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGoJump"
                            android:layout_width="200dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="#D0D0D0"
                            android:text="GO"
                            android:textColor="#000000"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:cornerRadius="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Page Navigation Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrevPage"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="আগের পৃষ্ঠা"
                        android:textColor="@color/secondary"
                        app:icon="@android:drawable/ic_media_previous"
                        app:iconTint="@color/secondary" />

                    <TextView
                        android:id="@+id/tvPageHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="পৃষ্ঠা ২৫ (পারা ২)" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNextPage"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="পরের পৃষ্ঠা"
                        android:textColor="@color/secondary"
                        app:icon="@android:drawable/ic_media_next"
                        app:iconGravity="end"
                        app:iconTint="@color/secondary" />

                </LinearLayout>

                <!-- 15-LINE HAFEZI QURAN PAGE FRAME (Matching Images 2 & 3) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuranPage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#1F2937"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_hafezi_quran_frame"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- TOP PAGE HEADER (Surah Name | Page Num | Para Name) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:id="@+id/tvFrameLeftInfo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="start"
                                android:textColor="#000000"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="سورة يس" />

                            <TextView
                                android:id="@+id/tvFramePageNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#000000"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="23" />

                            <TextView
                                android:id="@+id/tvFrameRightInfo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="#000000"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="وَمَالِي ২৩" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1.5dp"
                            android:background="#000000" />

                        <ProgressBar
                            android:id="@+id/pbPageLoading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="32dp"
                            android:indeterminateTint="@color/secondary"
                            android:visibility="gone" />

                        <!-- 15 LINES CONTAINER -->
                        <LinearLayout
                            android:id="@+id/layout15LinesContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="4dp">

                            <!-- 15 Line items will be loaded dynamically -->

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1.5dp"
                            android:background="#000000" />

                        <!-- BOTTOM PAGE FOOTER (Manzil Indicator) -->
                        <TextView
                            android:id="@+id/tvFrameFooterInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingTop="6dp"
                            android:paddingBottom="2dp"
                            android:text="منزل ه"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <!-- BOTTOM AUDIO PLAYER BAR -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAudioPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/secondary"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Audio icon"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    app:tint="@color/secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAudioSurahTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="চলছে: সুরা আল-ফাতিহা" />

                    <TextView
                        android:id="@+id/tvAudioReciter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ক্বারী মিশারী রশিদ আল-আফাসী"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnAudioToggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Play/Pause"
                    android:src="@android:drawable/ic_media_pause"
                    app:tint="@color/secondary" />

                <ImageButton
                    android:id="@+id/btnAudioClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="বন্ধ করুন"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/error" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbAudioProgress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:indeterminate="false"
                android:progressTint="@color/secondary" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
