<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="7dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/dua_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/dua_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="13dp">

        <ImageView
            android:id="@+id/ivDuaIllustration"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:contentDescription="ইসলামিক বিষয়ভিত্তিক ছবি"
            android:scaleType="centerCrop"
            android:src="@drawable/dua_cat_mosque" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDuaTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="দোয়ার শিরোনাম"
                android:textColor="@color/dua_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDuaCategoryTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dua_count"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:text="ক্যাটাগরি"
                android:textColor="@color/dua_primary_dark"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDuaArabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="end"
            android:lineSpacingExtra="4dp"
            android:maxLines="3"
            android:text="الْقُرْآنُ الْكَرِيمُ"
            android:textColor="#A17B2E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDuaTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="অর্থ:"
            android:textColor="@color/dua_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDuaWhen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="@color/dua_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenDuaDetail"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="বিস্তারিত পড়ুন"
            android:textColor="@color/dua_primary"
            app:backgroundTint="@color/dua_soft_green"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_view"
            app:iconTint="@color/dua_primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
