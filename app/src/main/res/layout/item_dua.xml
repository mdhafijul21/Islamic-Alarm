<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/waqt_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="13dp">

        <!-- Category & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDuaTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="দোআ শিরোনাম"
                android:textColor="@color/secondary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDuaCategoryTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_label_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="ক্যাটাগরি"
                android:textColor="@color/secondary"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Arabic Text -->
        <TextView
            android:id="@+id/tvDuaArabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:lineSpacingExtra="4dp"
            android:text="القرآن الكريم"
            android:textColor="@color/secondary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Bangla Transliteration -->
        <TextView
            android:id="@+id/tvDuaTransliteration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="উচ্চারণ:"
            android:textColor="@color/waqt_text_dark"
            android:textSize="14sp"
            android:textStyle="italic" />

        <!-- Bangla Meaning -->
        <TextView
            android:id="@+id/tvDuaTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="অর্থ:"
            android:textColor="@color/waqt_text_dark"
            android:textSize="14sp" />

        <!-- Reference -->
        <TextView
            android:id="@+id/tvDuaReference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="রেফারেন্স:"
            android:textColor="@color/waqt_text_dark_secondary"
            android:textSize="12sp" />

        <!-- Actions: Copy & Share -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyDua"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="কপি"
                android:textColor="@color/secondary"
                app:icon="@android:drawable/ic_menu_save"
                app:iconTint="@color/secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareDua"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="শেয়ার"
                android:textColor="@color/secondary"
                app:icon="@android:drawable/ic_menu_share"
                app:iconTint="@color/secondary" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
