<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="7dp"
    app:cardBackgroundColor="@color/waqt_card_bg"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="13dp">

        <ImageView
            android:id="@+id/ivDuaIllustration"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:contentDescription="ইসলামিক বিষয়ভিত্তিক ছবি"
            android:scaleType="centerCrop"
            android:src="@drawable/dua_cat_mosque" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDuaTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="দোআ শিরোনাম"
                android:textColor="@color/secondary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDuaCategoryTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_label_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="ক্যাটাগরি"
                android:textColor="@color/secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDuaArabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:lineSpacingExtra="5dp"
            android:text="الْقُرْآنُ الْكَرِيمُ"
            android:textColor="@color/secondary"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDuaTransliteration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="উচ্চারণ:"
            android:textColor="@color/waqt_text_dark"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/tvDuaTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:lineSpacingExtra="3dp"
            android:text="অর্থ:"
            android:textColor="@color/waqt_text_dark"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDuaWhen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/waqt_text_dark"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDuaCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/waqt_text_dark"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDuaVirtue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/waqt_text_dark"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDuaGrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/waqt_text_dark_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDuaReference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="@color/waqt_text_dark_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyDua"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="কপি"
                android:textColor="@color/secondary"
                app:icon="@android:drawable/ic_menu_save"
                app:iconTint="@color/secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareDua"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="শেয়ার"
                android:textColor="@color/secondary"
                app:icon="@android:drawable/ic_menu_share"
                app:iconTint="@color/secondary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
