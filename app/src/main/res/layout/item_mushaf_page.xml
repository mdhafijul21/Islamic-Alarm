<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingHorizontal="6dp"
    android:paddingVertical="4dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <!-- Top Hafezi Mushaf Page Header: Surah (Right RTL) | ( Para : PageInPara ) (Center) | Juz (Left RTL) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvMushafTopSurah"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/al_qalam_quran_majeed_4"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textDirection="rtl"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="البقرة ٢" />

            <TextView
                android:id="@+id/tvMushafTopMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="( ০১ : ০৩ )" />

            <TextView
                android:id="@+id/tvMushafTopJuz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/al_qalam_quran_majeed_4"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textDirection="rtl"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="الم ١" />
        </LinearLayout>

        <!-- Page Body Row: Outer Left Margin-Mark Gutter + Double-Bordered 15-Line Mushaf Frame -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Slim left gutter for Ruku (ع) / Sajdah marks so internal 15 lines remain identical width -->
            <LinearLayout
                android:id="@+id/llMushafMarginMarks"
                android:layout_width="18dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="26dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hafezi_page_frame"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <!-- Dynamic 15 Ruled Rows (equal start-to-end justified lines) -->
                <LinearLayout
                    android:id="@+id/llMushafPageContent"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical" />

                <!-- Subtle Bottom Manzil, Per-Para Page, & Global Page Footer inside the frame -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMushafBottomManzil"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/al_qalam_quran_majeed_4"
                        android:gravity="start"
                        android:textColor="@color/dua_muted"
                        android:textSize="12sp"
                        tools:text="منزل ١" />

                    <TextView
                        android:id="@+id/tvMushafBottomPage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_quran_chip"
                        android:fontFamily="@font/al_qalam_quran_majeed_4"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="1dp"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="﴿ ٣ / ٢١ ﴾" />

                    <TextView
                        android:id="@+id/tvMushafBottomLineHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="মোট পৃষ্ঠা ১/৬১০"
                        android:textColor="@color/dua_muted"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
