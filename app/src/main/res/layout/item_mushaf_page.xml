<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingHorizontal="6dp"
    android:paddingVertical="4dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <!-- Top Hafezi Mushaf Page Header: Juz (Right RTL) | Page/Manzil (Center) | Surah (Left RTL) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvMushafTopSurah"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:ellipsize="end"
                android:fontFamily="@font/al_qalam_quran_majeed_4"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="@color/dua_primary_dark"
                android:textDirection="rtl"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="البقرة ٢" />

            <TextView
                android:id="@+id/tvMushafTopMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="( ০১ : ০৩ )" />

            <TextView
                android:id="@+id/tvMushafTopJuz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/al_qalam_quran_majeed_4"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/dua_primary_dark"
                android:textDirection="rtl"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="الم ١" />
        </LinearLayout>

        <!-- Ornamental Double-Bordered 15-Line Hafezi Mushaf Page Frame -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hafezi_page_frame"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <!-- Dynamic 15 Ruled Rows (or centered 7-line opening page for Page 1 & 2) -->
            <LinearLayout
                android:id="@+id/llMushafPageContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" />

            <!-- Subtle Bottom Page & Manzil Footer inside the frame -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMushafBottomManzil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/al_qalam_quran_majeed_4"
                    android:gravity="start"
                    android:textColor="@color/dua_muted"
                    android:textSize="12sp"
                    tools:text="منزل ١" />

                <TextView
                    android:id="@+id/tvMushafBottomPage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_quran_chip"
                    android:fontFamily="@font/al_qalam_quran_majeed_4"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="1dp"
                    android:textColor="@color/dua_primary_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="﴿ ٣ ﴾" />

                <TextView
                    android:id="@+id/tvMushafBottomLineHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="১৫ লাইন হাফেজী"
                    android:textColor="@color/dua_muted"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
