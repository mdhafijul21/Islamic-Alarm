<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Chapter Number & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvChapterBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_label_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="অধ্যায় ১"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChapterTitleBn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="ওহীর সূচনা ও নিয়তের গুরুত্ব" />

        </LinearLayout>

        <!-- Arabic Text (if present) -->
        <TextView
            android:id="@+id/tvChapterArabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_arabic_verse"
            android:gravity="end"
            android:lineSpacingExtra="6dp"
            android:padding="12dp"
            android:textColor="@color/secondary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="إِنَّمَا الأَعْمَالُ بِالنِّيَّاتِ" />

        <!-- Bangla Content -->
        <TextView
            android:id="@+id/tvChapterContentBn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="সকল আমলের ফলাফল নিয়তের ওপর নির্ভরশীল..." />

        <!-- Explanation / Masail note -->
        <LinearLayout
            android:id="@+id/layoutExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_challenge_badge"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 তাৎপর্য ও শিক্ষা:"
                android:textColor="@color/secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChapterExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                tools:text="যেকোনো নেক কাজ কবুল হওয়ার পূর্বশর্ত হলো একনিষ্ঠ নিয়ত..." />

        </LinearLayout>

        <!-- Reference -->
        <TextView
            android:id="@+id/tvChapterReference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="সহিহ বুখারী: হাদিস নং ১" />

        <!-- Action Buttons: TTS Audio Listen, Copy, Share -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTtsListen"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="শুনুন"
                android:textColor="@color/secondary"
                app:icon="@android:drawable/ic_lock_silent_mode_off"
                app:iconTint="@color/secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyChapter"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="কপি"
                android:textColor="@color/secondary"
                app:icon="@android:drawable/ic_menu_save"
                app:iconTint="@color/secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareChapter"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="শেয়ার"
                android:textColor="@color/secondary"
                app:icon="@android:drawable/ic_menu_share"
                app:iconTint="@color/secondary" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
