<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dua_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDuaDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/dua_background"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="@color/dua_primary"
        app:title="দোয়ার বিস্তারিত"
        app:titleTextColor="@color/dua_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/dua_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/dua_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvDetailCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dua_count"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="ক্যাটাগরি"
                        android:textColor="@color/dua_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="দোয়ার শিরোনাম"
                        android:textColor="@color/dua_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="54dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/dua_accent" />

                    <TextView
                        android:id="@+id/tvDetailArabic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="end"
                        android:lineSpacingExtra="9dp"
                        android:text="الْقُرْآنُ الْكَرِيمُ"
                        android:textColor="#A17B2E"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailTransliteration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/dua_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvDetailTranslation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/dua_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvDetailWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/dua_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDetailCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/dua_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDetailVirtue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/dua_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvDetailGrade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/dua_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailReference"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/dua_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDetailUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:autoLink="web"
                        android:textColor="@color/dua_primary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailFavorite"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="পছন্দের তালিকায় রাখুন"
                        android:textColor="@color/dua_primary"
                        app:backgroundTint="@color/dua_soft_lavender"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/btn_star_big_on"
                        app:iconTint="@color/dua_accent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDetailCopy"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="কপি"
                            android:textColor="@color/dua_primary"
                            app:backgroundTint="@color/dua_soft_green"
                            app:cornerRadius="12dp"
                            app:icon="@android:drawable/ic_menu_save"
                            app:iconTint="@color/dua_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDetailShare"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="শেয়ার"
                            android:textColor="@color/dua_primary"
                            app:backgroundTint="@color/dua_soft_gold"
                            app:cornerRadius="12dp"
                            app:icon="@android:drawable/ic_menu_share"
                            app:iconTint="@color/dua_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
